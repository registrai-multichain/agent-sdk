{
  "name": "@registrai/agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for writing oracle agents on the Registrai protocol. Runtime-agnostic — works in Node, Cloudflare Workers, Phala CVMs, any modern JS runtime.",
  "license": "MIT",
  "homepage": "https://registrai.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/registrai-multichain/agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/registrai-multichain/agent-sdk/issues"
  },
  "keywords": [
    "oracle",
    "prediction-market",
    "arc",
    "evm",
    "viem",
    "registrai"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  }
}
